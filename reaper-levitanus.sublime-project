{
	"folders": [
		{
			"path": ".",
		}
	],
	"build_systems": [
		{
			"name": "Build & Copy Integration Test",
			"shell_cmd": "cargo build --all && cp ./target/debug/libreaper_test_extension_plugin.so ./target/reaper/reaper_linux_x86_64/REAPER/UserPlugins/reaper_test_extension_plugin.so",
			"working_dir": "$project_path",
		},
		{
			"name": "Run REAPER",
			"target": "terminus_exec",
			"shell_cmd": "./target/reaper/reaper_linux_x86_64/REAPER/reaper",
			"working_dir": "$project_path",
			"env": {
				"RUST_LOG": "debug,rea_rs::ext_state=info,reaper_levitanus=trace",
				"RUST_BACKTRACE": "full",
			},
			"auto_close": false,
		}
	],
	"settings":
	{
		"TestManager":
		{
			"data_location": ".sublime-tests",
			"test_suites":
			[
				{
					"args":
					[
					],
					"cargo": "cargo",
					"cwd": null,
					"discover_args":
					[
						"test",
						"--",
						"--list",
						"--test-threads=1",
						"--nocapture",
						"--format=json",
						"-Z",
						"unstable-options"
					],
					"env":
					{
					},
					"framework": "cargo",
					"id": "cargo1",
					"parser": "default",
					"run_args":
					[
						"test",
						"--",
						"--test-threads=1",
						"--nocapture",
						"--exact",
						"--format=json",
						"-Z",
						"unstable-options"
					]
				}
			],
		},
	},
}
